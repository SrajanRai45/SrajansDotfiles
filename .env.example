# ==============================================================================
# SrajansDotfiles - Local Environment & Private Paths Template
# ==============================================================================
# Copy this file to '.env' in this directory (or ~/.env):
#   cp .env.example .env
#
# The '.env' file is ignored by Git and will NEVER be uploaded to GitHub.
# Use this file to define private paths, repositories, tokens, and machine overrides.
# Variables defined here are automatically loaded into Fish, Bash scripts, and Hyprland.
# ==============================================================================

# --- PRIVATE REPOSITORIES & WORKSPACES ---
# Paths to your private repositories or personal projects
PRIVATE_REPO_DIR="$HOME/Repositories/private-repo"
OBSIDIAN_VAULT_DIR="$HOME/Repositories/obsidian_notes_sync"
PROJECTS_DIR="$HOME/Repositories"

# --- PERSONAL ASSETS & DIRECTORIES ---
# Wallpapers directory used by themeSwitcher.fish and Pywal16
WALLPAPERS_DIR="$HOME/Pictures/Wallpapers"

# Screenshots directory
SCREENSHOTS_DIR="$HOME/Pictures/Screenshots"

# --- LOCAL TOOL PATHS ---
# Spicetify / custom binaries
SPICETIFY_DIR="$HOME/.spicetify"

# --- HARDWARE & DISPLAY OVERRIDES ---
# Primary monitor name (check with 'hyprctl monitors')
# PRIMARY_MONITOR="eDP-1"
# Battery sysfs device name used by batteryNotify
# BATTERY_DEVICE="BAT0"

# --- PRIVATE API KEYS & TOKENS ---
# GITHUB_TOKEN=""
# OPENAI_API_KEY=""
